# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# Anthropic (the agent loop). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Database. SQLite for quick local dev; Postgres for parity/production.
DATABASE_URL=sqlite:///./dentops.db
# DATABASE_URL=postgresql+psycopg://dentops:dentops@localhost:5432/dentops

# App config
CONFIDENCE_THRESHOLD=0.7
MCP_HTTP_URL=http://localhost:8000/mcp

# Frontend (Vite): where the browser connects for the WebSocket stream
VITE_WS_URL=ws://localhost:8000/ws
